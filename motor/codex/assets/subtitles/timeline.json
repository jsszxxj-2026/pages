    }
  ],
  "power": [
    {
      "start": 0.0,
      "end": 5.388,
      "text": "兜兜、融融，看这团绕成圈的线，它叫线圈。"
    },
    {
      "start": 5.388,
      "end": 9.651,
      "text": "没通电时，线圈自己吸不住小铁片。"
    },
    {
      "start": 9.651,
      "end": 15.097,
      "text": "一通电，线圈就有了北极和南极，会推也会吸。"
    },
    {
      "start": 15.097,
      "end": 19.447,
      "text": "这种通电才有磁力的小磁铁，叫电磁铁。"
    }
  ],
  "push": [
    {
      "start": 0.0,
      "end": 4.425,
      "text": "马达两边各有一块磁铁，固定在外壳上。"
    },
    {
      "start": 4.425,
      "end": 8.686,
      "text": "一样的两极会推开，不一样的两极会拉近。"
    },
    {
      "start": 8.686,
      "end": 13.994,
      "text": "两边的磁铁一起推拉，把线圈和中间的轴拧着转。"
    }
  ],
  "shaft": [
    {
      "start": 0.0,
      "end": 6.039,
      "text": "电流要是一直朝同一个方向，线圈转到正对就会停住。"
    },
    {
      "start": 6.039,
      "end": 10.725,
      "text": "轴每转半圈，电刷就碰到另一块金属片。"
    },
    {
      "start": 10.725,
      "end": 14.853,
      "text": "这个让电流掉头的巧机关，叫换向器。"
    },
    {
      "start": 14.853,
      "end": 18.999,
      "text": "线圈借着刚才的劲儿，滑过正对的位置。"
    },
    {
      "start": 18.999,
      "end": 23.449,
      "text": "南北极一交换，刚才拉近的又互相推开。"
    },
    {
      "start": 23.449,
      "end": 28.627,
      "text": "线圈顺着原来的方向，转呀转，就能一直转啦！"
    }
  ],
  "open": [
    {
      "start": 0.0,
      "end": 2.916,
      "text": "我们把马达分开，瞧一瞧。"
    },
    {
      "start": 2.916,
      "end": 7.224,
      "text": "外壳里有磁铁和线圈，中间是转轴。"
    },
    {
      "start": 7.224,
      "end": 10.913,
      "text": "把零件合起来，小马达又能转啦！"
    }
  ],
  "inspect": [
    {
      "start": 0.0,
      "end": 6.758,
      "text": "外壳像小盒子。磁铁和线圈在盒子里，转轴从中间伸出来。"
    }
  ]
